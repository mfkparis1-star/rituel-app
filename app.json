{
  "expo": {
    "name": "Rituel",
    "slug": "rituel",
    "version": "1.4.2",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "rituel",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F6F1EC"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.mfkparis.rituel",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSPhotoLibraryAddUsageDescription": "Rituel peut sauvegarder vos photos et résultats d'analyse dans votre bibliothèque."
      },
      "config": {
        "usesNonExemptEncryption": false
      },
      "usesAppleSignIn": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#F6F1EC"
      },
      "package": "com.mfkparis.rituel",
      "versionCode": 2,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ],
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "locales": {
      "fr": "./locales/fr.json",
      "en": "./locales/en.json",
      "tr": "./locales/tr.json"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "Rituel utilise vos photos pour votre archive beauté et votre journal peau.",
          "cameraPermission": "Rituel utilise la caméra pour scanner vos produits."
        }
      ],
      [
        "expo-localization",
        {
          "supportedLocales": {
            "ios": ["fr", "en", "tr"]
          }
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#C08A6A"
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#F6F1EC",
          "imageWidth": 180
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "2650765f-b690-41db-966d-5fe6288603ec"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/2650765f-b690-41db-966d-5fe6288603ec"
    },
    "owner": "rituel-app"
  }
}